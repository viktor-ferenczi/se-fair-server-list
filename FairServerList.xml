    <!-- The ID of your plugin, never change this -->
    <Id>5BD64355-A190-45AC-827E-6125BB95642C</Id>

    <!-- GitHub repository ID -->
    <RepoId>viktor-ferenczi/se-fair-server-list</RepoId>

    <!-- The name of your plugin that will appear in the plugin list -->
    <FriendlyName>Fair Server List</FriendlyName>

    <!-- The author name that you want to appear in the plugin list -->
    <Author>Viktor</Author>

    <!-- Optional tooltip for the plugin in the plugin list -->
    <Tooltip>Server list sorted by player count, without pinned "recommended" servers</Tooltip>

    <!-- Optional plugin description. If omitted, this will be the same as the Tooltip. 1000 characters max. -->
    <Description>Makes the server list in Join Game fair to every server.

        - Keen's "recommended" servers are no longer pinned to the top of the list and lose their star.
        - The list is sorted by player count by default, busiest first.
        - Click any column header to sort by it instead, as before. All the vanilla filters work as before.

        Report bugs on GitHub: https://github.com/viktor-ferenczi/se-fair-server-list/issues
    </Description>

    <!-- Only source code in the Directory entries listed in SourceDirectories is compiled. Exclude any test projects or similar. -->
